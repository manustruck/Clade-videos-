{
 "total": 35.327,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 2.661,
   "texto": "One step is one inch taller. That's how you fall!",
   "h": 0
  },
  {
   "i": 1,
   "a": 2.811,
   "b": 5.126,
   "texto": "Smash like and follow. Flo thinks I'm crazy.",
   "h": 0
  },
  {
   "i": 2,
   "a": 5.246,
   "b": 8.435,
   "texto": "Please! It's one inch. Nobody trips over one inch.",
   "h": 1
  },
  {
   "i": 3,
   "a": 8.555,
   "b": 10.775,
   "texto": "Your feet do. They don't look at every step.",
   "h": 0
  },
  {
   "i": 4,
   "a": 10.875,
   "b": 15.314,
   "texto": "Studies show people don't even notice a taller step, and their toe doesn't lift high enough.",
   "h": 0
  },
  {
   "i": 5,
   "a": 15.434,
   "b": 15.899,
   "texto": "So?",
   "h": 1
  },
  {
   "i": 6,
   "a": 15.999,
   "b": 18.466,
   "texto": "So that toe catches the edge, and down you go!",
   "h": 0
  },
  {
   "i": 7,
   "a": 18.916,
   "b": 19.995,
   "texto": "Whoa! Okay. Ow.",
   "h": 1
  },
  {
   "i": 8,
   "a": 20.145,
   "b": 23.475,
   "texto": "That's why the code allows only three eighths of an inch between steps.",
   "h": 0
  },
  {
   "i": 9,
   "a": 23.575,
   "b": 25.912,
   "texto": "Measure every riser. Make them all the same.",
   "h": 0
  },
  {
   "i": 10,
   "a": 26.032,
   "b": 28.558,
   "texto": "Fine. But perfect stairs are boring!",
   "h": 1
  },
  {
   "i": 11,
   "a": 28.658,
   "b": 30.423,
   "texto": "Boring stairs don't break your ankle.",
   "h": 0
  },
  {
   "i": 12,
   "a": 30.623,
   "b": 33.01,
   "texto": "Team Norm or Team Flo? Fight in the comments!",
   "h": 0
  },
  {
   "i": 13,
   "a": 33.21,
   "b": 35.327,
   "texto": "Follow for more backyard builds that won't fail!",
   "h": 0
  }
 ],

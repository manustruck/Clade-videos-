{
 "total": 36.593,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 2.215,
   "texto": "Your gutter is secretly flooding your basement!"
  },
  {
   "i": 1,
   "a": 2.465,
   "b": 4.724,
   "texto": "Right now. And you can't even see it."
  },
  {
   "i": 2,
   "a": 4.924,
   "b": 7.724,
   "texto": "The downspout drops all that rain right next to your house."
  },
  {
   "i": 3,
   "a": 8.024,
   "b": 9.222,
   "texto": "Looks harmless, right?"
  },
  {
   "i": 4,
   "a": 9.372,
   "b": 11.358,
   "texto": "But the soil soaks it up like a sponge."
  },
  {
   "i": 5,
   "a": 11.558,
   "b": 14.681,
   "texto": "The water pushes on the wall, and sneaks through the tiniest crack."
  },
  {
   "i": 6,
   "a": 15.081,
   "b": 16.995,
   "texto": "And your basement becomes a swimming pool!"
  },
  {
   "i": 7,
   "a": 17.495,
   "b": 17.929,
   "texto": "Whoops!"
  },
  {
   "i": 8,
   "a": 18.129,
   "b": 19.008,
   "texto": "Here's the fix."
  },
  {
   "i": 9,
   "a": 19.108,
   "b": 22.302,
   "texto": "Add an extension, and send the water six to ten feet away."
  },
  {
   "i": 10,
   "a": 22.502,
   "b": 26.135,
   "texto": "Then slope the ground away from the house, about six inches over ten feet."
  },
  {
   "i": 11,
   "a": 26.385,
   "b": 28.367,
   "texto": "Now the rain goes anywhere but your basement."
  },
  {
   "i": 12,
   "a": 28.567,
   "b": 30.906,
   "texto": "Same house. Same rain. Dry socks!"
  },
  {
   "i": 13,
   "a": 31.206,
   "b": 34.146,
   "texto": "Does your downspout dump at the wall? Tell Norm in the comments!"
  },
  {
   "i": 14,
   "a": 34.396,
   "b": 36.593,
   "texto": "Follow for more backyard builds that won't fail!"
  }
 ],

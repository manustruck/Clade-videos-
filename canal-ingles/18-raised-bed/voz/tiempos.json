{
 "total": 38.931,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 1.924,
   "texto": "Your raised bed is about to burst open!",
   "h": 0
  },
  {
   "i": 1,
   "a": 2.044,
   "b": 4.317,
   "texto": "Hit like and follow. Flo filled this one to the top!",
   "h": 0
  },
  {
   "i": 2,
   "a": 4.437,
   "b": 7.499,
   "texto": "Tall boards, four corners, and lots of soil. Perfect!",
   "h": 1
  },
  {
   "i": 3,
   "a": 7.619,
   "b": 10.152,
   "texto": "Wet soil is heavy, and it pushes out on every wall.",
   "h": 0
  },
  {
   "i": 4,
   "a": 10.272,
   "b": 13.711,
   "texto": "The middle of the long side takes the most push. That's where it bows first.",
   "h": 0
  },
  {
   "i": 5,
   "a": 13.831,
   "b": 15.629,
   "texto": "So I just need thicker boards?",
   "h": 1
  },
  {
   "i": 6,
   "a": 15.749,
   "b": 18.558,
   "texto": "Thicker helps. But the real fix is a tie across the middle.",
   "h": 0
  },
  {
   "i": 7,
   "a": 18.678,
   "b": 23.195,
   "texto": "A board or a threaded rod, from one long side to the other. It holds both walls in.",
   "h": 0
  },
  {
   "i": 8,
   "a": 23.315,
   "b": 25.291,
   "texto": "Longer than eight feet? Use two ties.",
   "h": 0
  },
  {
   "i": 9,
   "a": 25.411,
   "b": 26.855,
   "texto": "And the corners keep moving!",
   "h": 1
  },
  {
   "i": 10,
   "a": 26.975,
   "b": 30.609,
   "texto": "Strong corner posts, screwed, not nailed. And sink them into the ground.",
   "h": 0
  },
  {
   "i": 11,
   "a": 30.729,
   "b": 33.07,
   "texto": "Fine. My garden bed is wearing a belt.",
   "h": 1
  },
  {
   "i": 12,
   "a": 33.19,
   "b": 36.716,
   "texto": "Thicker boards, or a tie across the middle? Team Norm or Team Flo?",
   "h": 0
  },
  {
   "i": 13,
   "a": 36.836,
   "b": 38.931,
   "texto": "Follow for more backyard builds that won't fail!",
   "h": 0
  }
 ],

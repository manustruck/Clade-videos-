{
 "total": 39.894,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 2.601,
   "texto": "Your gutters are overflowing, and they're not even clogged!",
   "h": 0
  },
  {
   "i": 1,
   "a": 2.721,
   "b": 5.143,
   "texto": "Hit like and follow. Flo hung these perfectly straight!",
   "h": 0
  },
  {
   "i": 2,
   "a": 5.263,
   "b": 8.107,
   "texto": "Level gutters look so clean! Straight as a ruler!",
   "h": 1
  },
  {
   "i": 3,
   "a": 8.227,
   "b": 11.912,
   "texto": "Level means the water just sits there. It fills up, and spills over the front.",
   "h": 0
  },
  {
   "i": 4,
   "a": 12.032,
   "b": 14.782,
   "texto": "Right onto your flower beds, and down next to the foundation.",
   "h": 0
  },
  {
   "i": 5,
   "a": 14.902,
   "b": 16.898,
   "texto": "So I tilt them? Won't that look crooked?",
   "h": 1
  },
  {
   "i": 6,
   "a": 17.018,
   "b": 21.084,
   "texto": "You won't even notice. A common target is a quarter inch of drop every ten feet.",
   "h": 0
  },
  {
   "i": 7,
   "a": 21.204,
   "b": 22.844,
   "texto": "Always sloping toward the downspout.",
   "h": 0
  },
  {
   "i": 8,
   "a": 22.964,
   "b": 26.527,
   "texto": "Snap a string line from the high end to the low end, and hang the brackets on it.",
   "h": 0
  },
  {
   "i": 9,
   "a": 26.647,
   "b": 28.273,
   "texto": "And if it still overflows?",
   "h": 1
  },
  {
   "i": 10,
   "a": 28.393,
   "b": 31.926,
   "texto": "You might need more downspouts. Often one every thirty to forty feet.",
   "h": 0
  },
  {
   "i": 11,
   "a": 32.046,
   "b": 34.24,
   "texto": "Fine. Crooked gutters. On purpose.",
   "h": 1
  },
  {
   "i": 12,
   "a": 34.36,
   "b": 37.746,
   "texto": "Perfectly level, or sloped to the spout? Team Norm or Team Flo?",
   "h": 0
  },
  {
   "i": 13,
   "a": 37.866,
   "b": 39.894,
   "texto": "Follow for more backyard builds that won't fail!",
   "h": 0
  }
 ],

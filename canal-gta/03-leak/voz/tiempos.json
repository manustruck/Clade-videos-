 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 3.82,
   "texto": "A leaked GTA 6 system might decide how the story ends, and you control it.",
   "h": 0
  },
  {
   "i": 1,
   "a": 3.88,
   "b": 5.792,
   "texto": "Part three of five. Follow for the rest.",
   "h": 0
  },
  {
   "i": 2,
   "a": 5.852,
   "b": 10.049,
   "texto": "In 2022, ninety early videos of GTA 6 leaked online.",
   "h": 0
  },
  {
   "i": 3,
   "a": 10.109,
   "b": 11.465,
   "texto": "Rockstar confirmed the breach.",
   "h": 0
  },
  {
   "i": 4,
   "a": 11.525,
   "b": 15.9,
   "texto": "Fans spotted debug menus that seem to track a police record, and characters who remember you.",
   "h": 0
  },
  {
   "i": 5,
   "a": 15.96,
   "b": 18.349,
   "texto": "The theory: a personality meter shapes your ending.",
   "h": 0
  },
  {
   "i": 6,
   "a": 18.409,
   "b": 22.232,
   "texto": "Play calm, and Lucia survives. Play reckless, and someone doesn't make it.",
   "h": 0
  },
  {
   "i": 7,
   "a": 22.292,
   "b": 24.824,
   "texto": "But here's the catch. The leak was a very early build.",
   "h": 0
  },
  {
   "i": 8,
   "a": 24.884,
   "b": 26.61,
   "texto": "Things can change a lot in four years.",
   "h": 0
  },
  {
   "i": 9,
   "a": 26.67,
   "b": 29.419,
   "texto": "And one thing in the trailer might break GTA's whole timeline.",
   "h": 0
  },
  {
   "i": 10,
   "a": 29.479,
   "b": 32.143,
   "texto": "Calm or reckless? Comment now. Part four is next.",
   "h": 0
  }
 ],

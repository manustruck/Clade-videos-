{
 "total": 37.848,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 2.149,
   "texto": "Your pergola is going to wobble like jelly!",
   "h": 0
  },
  {
   "i": 1,
   "a": 2.269,
   "b": 4.501,
   "texto": "Hit like and follow. Flo built this one herself!",
   "h": 0
  },
  {
   "i": 2,
   "a": 4.621,
   "b": 7.83,
   "texto": "Four big posts, beams on top. It's rock solid!",
   "h": 1
  },
  {
   "i": 3,
   "a": 7.95,
   "b": 10.601,
   "texto": "Push it sideways, and the square turns into a diamond.",
   "h": 0
  },
  {
   "i": 4,
   "a": 10.721,
   "b": 13.673,
   "texto": "That's called racking. Every gust of wind makes it a little worse.",
   "h": 0
  },
  {
   "i": 5,
   "a": 13.793,
   "b": 15.784,
   "texto": "So I just need bigger posts?",
   "h": 1
  },
  {
   "i": 6,
   "a": 15.904,
   "b": 17.259,
   "texto": "Nope. You need triangles.",
   "h": 0
  },
  {
   "i": 7,
   "a": 17.379,
   "b": 20.726,
   "texto": "A forty five degree knee brace, where every post meets the beam.",
   "h": 0
  },
  {
   "i": 8,
   "a": 20.846,
   "b": 24.72,
   "texto": "On both sides. Brace one direction, and it still wobbles the other way.",
   "h": 0
  },
  {
   "i": 9,
   "a": 24.84,
   "b": 26.245,
   "texto": "And the bottom of the posts?",
   "h": 1
  },
  {
   "i": 10,
   "a": 26.365,
   "b": 29.346,
   "texto": "Anchor them solid. Deep in the ground, or bolted down tight.",
   "h": 0
  },
  {
   "i": 11,
   "a": 29.466,
   "b": 32.693,
   "texto": "Fine. Triangles. My pergola is a math class now.",
   "h": 1
  },
  {
   "i": 12,
   "a": 32.813,
   "b": 35.727,
   "texto": "Bigger posts, or knee braces? Team Norm or Team Flo?",
   "h": 0
  },
  {
   "i": 13,
   "a": 35.847,
   "b": 37.848,
   "texto": "Follow for more backyard builds that won't fail!",
   "h": 0
  }
 ],

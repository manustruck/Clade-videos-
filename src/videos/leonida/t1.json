 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 3.99,
   "texto": "Lucia hugs Jason in GTA 6's second trailer, with a gun behind her back.",
   "h": 0
  },
  {
   "i": 1,
   "a": 4.05,
   "b": 7.01,
   "texto": "Fans say it proves she betrays him. And there are two more clues.",
   "h": 0
  },
  {
   "i": 2,
   "a": 7.07,
   "b": 8.677,
   "texto": "Follow, this is part one of five.",
   "h": 0
  },
  {
   "i": 3,
   "a": 8.737,
   "b": 12.066,
   "texto": "Clue two. The trailer's song is Love Is a Long Road, by Tom Petty.",
   "h": 0
  },
  {
   "i": 4,
   "a": 12.126,
   "b": 14.788,
   "texto": "Theorists read it as a warning about a partner you can't trust.",
   "h": 0
  },
  {
   "i": 5,
   "a": 14.848,
   "b": 18.323,
   "texto": "Clue three. Leonida's state seal looks like Florida's, with a few changes.",
   "h": 0
  },
  {
   "i": 6,
   "a": 18.383,
   "b": 20.652,
   "texto": "Some fans say those changes point straight at a traitor.",
   "h": 0
  },
  {
   "i": 7,
   "a": 20.712,
   "b": 21.655,
   "texto": "But here's the problem.",
   "h": 0
  },
  {
   "i": 8,
   "a": 21.715,
   "b": 24.04,
   "texto": "Another theory says the traitor isn't Lucia at all.",
   "h": 0
  },
  {
   "i": 9,
   "a": 24.1,
   "b": 26.586,
   "texto": "It says Jason has been hiding something since minute one.",
   "h": 0
  },
  {
   "i": 10,
   "a": 26.646,
   "b": 29.805,
   "texto": "Team Lucia or Team Jason? Comment now. Part two is next.",
   "h": 0
  }
 ],

 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 3.646,
   "texto": "Everybody's talking about Vice City. But it's only one of six regions.",
   "h": 0
  },
  {
   "i": 1,
   "a": 3.706,
   "b": 6.67,
   "texto": "Final part. Follow, because we test every theory at launch.",
   "h": 0
  },
  {
   "i": 2,
   "a": 6.73,
   "b": 8.738,
   "texto": "One. Vice City, the neon capital.",
   "h": 0
  },
  {
   "i": 3,
   "a": 8.798,
   "b": 12.258,
   "texto": "Two. The Leonida Keys, where the story reportedly begins.",
   "h": 0
  },
  {
   "i": 4,
   "a": 12.318,
   "b": 14.497,
   "texto": "Three. The Grassrivers, a giant swamp.",
   "h": 0
  },
  {
   "i": 5,
   "a": 14.557,
   "b": 15.687,
   "texto": "Four. Port Gellhorn.",
   "h": 0
  },
  {
   "i": 6,
   "a": 15.747,
   "b": 16.679,
   "texto": "Five. Ambrosia.",
   "h": 0
  },
  {
   "i": 7,
   "a": 16.739,
   "b": 18.722,
   "texto": "And six. Mount Kalaga National Park.",
   "h": 0
  },
  {
   "i": 8,
   "a": 18.782,
   "b": 20.899,
   "texto": "Some fans think even this isn't the whole map.",
   "h": 0
  },
  {
   "i": 9,
   "a": 20.959,
   "b": 26.459,
   "texto": "The game drops November nineteenth. Lucia, Jason, the meter, Phil, the map. We test all five.",
   "h": 0
  },
  {
   "i": 10,
   "a": 26.519,
   "b": 30.087,
   "texto": "Which theory is true? Comment one to five, and follow for the answers.",
   "h": 0
  }
 ],

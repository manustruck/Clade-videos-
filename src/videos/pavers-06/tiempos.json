{
 "total": 36.896,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 2.298,
   "texto": "Your patio is going to turn into waves!"
  },
  {
   "i": 1,
   "a": 2.548,
   "b": 5.25,
   "texto": "And it's not the pavers' fault. It's what's under them."
  },
  {
   "i": 2,
   "a": 5.45,
   "b": 8.173,
   "texto": "You laid the pavers straight on the dirt, and called it a day."
  },
  {
   "i": 3,
   "a": 8.473,
   "b": 9.644,
   "texto": "Looks perfect, right?"
  },
  {
   "i": 4,
   "a": 9.794,
   "b": 11.674,
   "texto": "Then it rains, and winter comes."
  },
  {
   "i": 5,
   "a": 11.874,
   "b": 15.775,
   "texto": "The soft soil shifts, the stones sink, and your patio starts to wave."
  },
  {
   "i": 6,
   "a": 16.225,
   "b": 17.808,
   "texto": "Until someone trips over it!"
  },
  {
   "i": 7,
   "a": 18.158,
   "b": 18.558,
   "texto": "Whoops!"
  },
  {
   "i": 8,
   "a": 18.758,
   "b": 20.52,
   "texto": "Here's the fix, in three layers."
  },
  {
   "i": 9,
   "a": 20.62,
   "b": 23.626,
   "texto": "First, four to six inches of compacted crushed stone."
  },
  {
   "i": 10,
   "a": 23.776,
   "b": 26.283,
   "texto": "Next, one inch of sand, smooth and flat."
  },
  {
   "i": 11,
   "a": 26.483,
   "b": 28.887,
   "texto": "Then lock in the edges, so nothing spreads."
  },
  {
   "i": 12,
   "a": 29.087,
   "b": 31.805,
   "texto": "Same pavers. Same patio. Zero waves!"
  },
  {
   "i": 13,
   "a": 32.105,
   "b": 34.566,
   "texto": "Did you skip the base? Tell Norm in the comments!"
  },
  {
   "i": 14,
   "a": 34.816,
   "b": 36.897,
   "texto": "Follow for more backyard builds that won't fail!"
  }
 ],

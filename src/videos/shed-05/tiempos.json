{
 "total": 30.917,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 1.384,
   "texto": "Your shed is going to sink!"
  },
  {
   "i": 1,
   "a": 1.584,
   "b": 2.204,
   "texto": "Here's why."
  },
  {
   "i": 2,
   "a": 2.404,
   "b": 5.273,
   "texto": "You set it right on the grass, because it looked flat enough."
  },
  {
   "i": 3,
   "a": 5.573,
   "b": 6.66,
   "texto": "Looks fine, right?"
  },
  {
   "i": 4,
   "a": 6.81,
   "b": 7.659,
   "texto": "Then it rains."
  },
  {
   "i": 5,
   "a": 7.759,
   "b": 11.547,
   "texto": "The soft soil washes out under one corner, and the shed starts to lean."
  },
  {
   "i": 6,
   "a": 12.047,
   "b": 13.987,
   "texto": "The door jams. The floor rots."
  },
  {
   "i": 7,
   "a": 14.437,
   "b": 14.858,
   "texto": "Whoops!"
  },
  {
   "i": 8,
   "a": 15.058,
   "b": 15.891,
   "texto": "Here's the fix."
  },
  {
   "i": 9,
   "a": 15.991,
   "b": 19.842,
   "texto": "First, dig out the grass, and add four to six inches of crushed stone."
  },
  {
   "i": 10,
   "a": 20.042,
   "b": 22.506,
   "texto": "Next, pack it down tight, and make it level."
  },
  {
   "i": 11,
   "a": 22.706,
   "b": 25.82,
   "texto": "Now the shed sits on a solid base, and the water drains away."
  },
  {
   "i": 12,
   "a": 26.1,
   "b": 28.408,
   "texto": "Same shed. Same door. No more jamming!"
  },
  {
   "i": 13,
   "a": 28.688,
   "b": 30.917,
   "texto": "Follow for more backyard builds that won't fail!"
  }
 ],

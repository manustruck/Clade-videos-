{
 "total": 38.21,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 1.343,
   "texto": "Your drain is running uphill!",
   "h": 0
  },
  {
   "i": 1,
   "a": 1.463,
   "b": 3.977,
   "texto": "Hit like and follow. Flo dug this one with no level!",
   "h": 0
  },
  {
   "i": 2,
   "a": 4.097,
   "b": 7.628,
   "texto": "A pipe in a trench. Water goes in, water goes out. Done!",
   "h": 1
  },
  {
   "i": 3,
   "a": 7.748,
   "b": 10.586,
   "texto": "Water only flows downhill. Your pipe has a dip in the middle.",
   "h": 0
  },
  {
   "i": 4,
   "a": 10.706,
   "b": 14.456,
   "texto": "Water sits in that low spot, and dirt settles in it. Soon, it's clogged.",
   "h": 0
  },
  {
   "i": 5,
   "a": 14.576,
   "b": 16.634,
   "texto": "So I just dig deeper at the end?",
   "h": 1
  },
  {
   "i": 6,
   "a": 16.754,
   "b": 19.33,
   "texto": "You need a steady fall, the whole way. No dips.",
   "h": 0
  },
  {
   "i": 7,
   "a": 19.45,
   "b": 23.013,
   "texto": "At least one eighth of an inch per foot. That's about an inch every eight feet.",
   "h": 0
  },
  {
   "i": 8,
   "a": 23.133,
   "b": 25.233,
   "texto": "Check it with a string line or a level as you go.",
   "h": 0
  },
  {
   "i": 9,
   "a": 25.353,
   "b": 26.48,
   "texto": "And where does it come out?",
   "h": 1
  },
  {
   "i": 10,
   "a": 26.6,
   "b": 29.853,
   "texto": "At the lowest point of your yard, out in the open. That's called daylight.",
   "h": 0
  },
  {
   "i": 11,
   "a": 29.973,
   "b": 33.109,
   "texto": "Fine. My drain goes downhill. Just like my weekend.",
   "h": 1
  },
  {
   "i": 12,
   "a": 33.229,
   "b": 36.032,
   "texto": "Just dig it, or slope it right? Team Norm or Team Flo?",
   "h": 0
  },
  {
   "i": 13,
   "a": 36.152,
   "b": 38.21,
   "texto": "Follow for more backyard builds that won't fail!",
   "h": 0
  }
 ],

{
 "total": 43.623,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 1.969,
   "texto": "Your new concrete slab is going to crack!",
   "h": 0
  },
  {
   "i": 1,
   "a": 2.119,
   "b": 4.49,
   "texto": "Hit like and follow. Flo thinks she beat concrete!",
   "h": 0
  },
  {
   "i": 2,
   "a": 4.61,
   "b": 8.373,
   "texto": "Not mine! I poured it nice and smooth. No ugly lines!",
   "h": 1
  },
  {
   "i": 3,
   "a": 8.493,
   "b": 11.062,
   "texto": "Concrete shrinks as it dries. It pulls on itself.",
   "h": 0
  },
  {
   "i": 4,
   "a": 11.162,
   "b": 14.646,
   "texto": "With no lines, it picks its own spot. Usually right across the middle.",
   "h": 0
  },
  {
   "i": 5,
   "a": 14.796,
   "b": 17.641,
   "texto": "Wait. Those lines on sidewalks aren't just for looks?",
   "h": 1
  },
  {
   "i": 6,
   "a": 17.761,
   "b": 22.416,
   "texto": "Nope. They're control joints. A weak spot on purpose, so the crack hides inside the line.",
   "h": 0
  },
  {
   "i": 7,
   "a": 22.566,
   "b": 25.483,
   "texto": "For a four inch slab, cut a joint every eight to twelve feet.",
   "h": 0
  },
  {
   "i": 8,
   "a": 25.603,
   "b": 30.209,
   "texto": "About one inch deep, a quarter of the thickness. Cut them early, before it cracks on its own.",
   "h": 0
  },
  {
   "i": 9,
   "a": 30.359,
   "b": 31.441,
   "texto": "And the dirt under it?",
   "h": 1
  },
  {
   "i": 10,
   "a": 31.541,
   "b": 34.285,
   "texto": "A compacted gravel base. Soft spots crack it too.",
   "h": 0
  },
  {
   "i": 11,
   "a": 34.435,
   "b": 37.27,
   "texto": "Fine. My smooth slab was a crack waiting to happen.",
   "h": 1
  },
  {
   "i": 12,
   "a": 37.47,
   "b": 41.403,
   "texto": "Lines in concrete. Just for looks, or crack control? Team Norm or Team Flo?",
   "h": 0
  },
  {
   "i": 13,
   "a": 41.603,
   "b": 43.624,
   "texto": "Follow for more backyard builds that won't fail!",
   "h": 0
  }
 ],

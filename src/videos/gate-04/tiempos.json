{
 "total": 32.713,
 "frases": [
  {
   "i": 0,
   "a": 0.15,
   "b": 1.484,
   "texto": "Your gate is going to sag!"
  },
  {
   "i": 1,
   "a": 1.684,
   "b": 2.336,
   "texto": "Here's why."
  },
  {
   "i": 2,
   "a": 2.536,
   "b": 6.76,
   "texto": "You built a nice square frame, hung it on two hinges, and went inside for lemonade."
  },
  {
   "i": 3,
   "a": 7.11,
   "b": 8.275,
   "texto": "Looks perfect, right?"
  },
  {
   "i": 4,
   "a": 8.425,
   "b": 9.487,
   "texto": "But the gate is heavy."
  },
  {
   "i": 5,
   "a": 9.637,
   "b": 13.447,
   "texto": "It pulls down on the far corner, and the square slowly turns into a lean."
  },
  {
   "i": 6,
   "a": 13.947,
   "b": 16.202,
   "texto": "A few months later, it drags on the ground!"
  },
  {
   "i": 7,
   "a": 16.752,
   "b": 17.151,
   "texto": "Whoops!"
  },
  {
   "i": 8,
   "a": 17.351,
   "b": 18.184,
   "texto": "Here's the fix."
  },
  {
   "i": 9,
   "a": 18.284,
   "b": 19.678,
   "texto": "Add one diagonal brace."
  },
  {
   "i": 10,
   "a": 19.828,
   "b": 24.155,
   "texto": "It runs from the bottom, on the hinge side, up to the top, on the latch side."
  },
  {
   "i": 11,
   "a": 24.355,
   "b": 27.415,
   "texto": "Now the weight pushes straight down the brace, and into the post."
  },
  {
   "i": 12,
   "a": 27.615,
   "b": 30.226,
   "texto": "Same gate. Same hinges. Smooth swing!"
  },
  {
   "i": 13,
   "a": 30.506,
   "b": 32.714,
   "texto": "Follow for more backyard builds that won't fail!"
  }
 ],
